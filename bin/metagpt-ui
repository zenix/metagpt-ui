#!/usr/bin/env bash
# metagpt-ui — Start the MetaGPT web dashboard on http://localhost:8080
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(dirname "$SCRIPT_DIR")"
VENV="${APP_DIR}/.venv"

if [[ ! -d "$VENV" ]]; then
    echo "[metagpt-ui] Creating Python venv..."
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install -q -r "$APP_DIR/requirements.txt"
    echo "[metagpt-ui] Dependencies installed."
fi

echo "[metagpt-ui] MetaGPT Dashboard → http://localhost:8080"

# Open browser once the server is ready
(
    until curl -sf http://localhost:8080 > /dev/null 2>&1; do sleep 0.5; done
    xdg-open http://localhost:8080 2>/dev/null || open http://localhost:8080 2>/dev/null || true
) &

exec "$VENV/bin/uvicorn" app:app --app-dir "$APP_DIR" --host 0.0.0.0 --port 8080 --reload
